# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TWILIO API CREDENTIALS: Required for sending real SMS carrier text messages.
# Configure these in the AI Studio Settings panel or directly inside the Loan Officer Portal Twilio Settings.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# GOOGLE WORKSPACE OAUTH: Optional client ID for Google Workspace integration (Calendar, Gmail, Sheets, Drive, Tasks, Contacts)
VITE_GOOGLE_CLIENT_ID=

# BIG PURPLE DOT (BPD) MORTGAGE & RECRUITING CRM INTEGRATION
# Required for live sync with Big Purple Dot CRM, candidate pipelines, and automated recruiting webhooks
BIG_PURPLE_DOT_API_KEY=
BIG_PURPLE_DOT_SECRET=
BIG_PURPLE_DOT_SUBDOMAIN=
BIG_PURPLE_DOT_WEBHOOK_SECRET=
BIG_PURPLE_DOT_ENV="sandbox" # "sandbox" or "production"
