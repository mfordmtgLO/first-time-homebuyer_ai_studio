rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    // Allow anyone to read the state
    match /guides_state/{docId} {
      allow read: if true;
      allow write: if true; // Prototype CMS
    }
    
    match /loan_officers/{loId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /agents/{agentId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
