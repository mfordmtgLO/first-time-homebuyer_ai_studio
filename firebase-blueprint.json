{
  "entities": {
    "LoanOfficerProfile": {
      "title": "LoanOfficerProfile",
      "description": "Loan Officer Profile containing headshot and other details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "nmlsId": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "headshotUrl": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        },
        "websiteUrl": {
          "type": "string"
        },
        "customSlug": {
          "type": "string"
        },
        "isAdmin": {
          "type": "boolean"
        },
        "password": {
          "type": "string"
        },
        "passwordResetAuthorized": {
          "type": "boolean"
        },
        "passwordResetRequestedAt": {
          "type": "string"
        },
        "passwordResetAuthorizedAt": {
          "type": "string"
        },
        "passwordResetPin": {
          "type": "string"
        },
        "lastLogin": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "RealEstateAgentProfile": {
      "title": "RealEstateAgentProfile",
      "description": "Real Estate Agent Profile containing headshot and other details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "brokerage": {
          "type": "string"
        },
        "licenseNumber": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "headshotUrl": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "GuidesState": {
      "title": "GuidesState",
      "description": "Global state for the application",
      "type": "object",
      "properties": {
        "stateJson": {
          "type": "string"
        }
      },
      "required": [
        "stateJson"
      ]
    },
    "EmailTemplate": {
      "title": "EmailTemplate",
      "description": "Draft email templates for agent outreach",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isArchived": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "subject",
        "body",
        "isArchived",
        "ownerId"
      ]
    },
    "TwilioVault": {
      "title": "TwilioVault",
      "description": "Secure storage for encrypted Twilio credentials",
      "type": "object",
      "properties": {
        "encryptedVault": { "type": "string", "maxLength": 2048 },
        "enableLiveCarrierSms": { "type": "boolean" },
        "ownerId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string" }
      },
      "required": ["encryptedVault", "enableLiveCarrierSms", "ownerId", "updatedAt"]
    }
  },
  "firestore": {
    "twilio_vault/{userId}": {
      "schema": { "$ref": "#/entities/TwilioVault" },
      "description": "Encrypted Twilio credentials for a user"
    },
    "guides_state/{docId}": {
      "schema": "GuidesState",
      "description": "Global state singleton"
    },
    "loan_officers/{loId}": {
      "schema": "LoanOfficerProfile",
      "description": "Loan officers collection"
    },
    "agents/{agentId}": {
      "schema": "RealEstateAgentProfile",
      "description": "Agents collection"
    },
    "email_templates/{templateId}": {
      "schema": "EmailTemplate",
      "description": "Email templates created by loan officers"
    }
  }
}