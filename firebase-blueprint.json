{
  "entities": {
    "LoanOfficerProfile": {
      "title": "LoanOfficerProfile",
      "description": "Loan Officer Profile containing headshot and other details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "nmlsId": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "headshotUrl": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        },
        "websiteUrl": {
          "type": "string"
        },
        "customSlug": {
          "type": "string"
        },
        "isAdmin": {
          "type": "boolean"
        },
        "password": {
          "type": "string"
        },
        "passwordResetAuthorized": {
          "type": "boolean"
        },
        "passwordResetRequestedAt": {
          "type": "string"
        },
        "passwordResetAuthorizedAt": {
          "type": "string"
        },
        "passwordResetPin": {
          "type": "string"
        },
        "lastLogin": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "RealEstateAgentProfile": {
      "title": "RealEstateAgentProfile",
      "description": "Real Estate Agent Profile containing headshot and other details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "brokerage": {
          "type": "string"
        },
        "licenseNumber": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "headshotUrl": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "GuidesState": {
      "title": "GuidesState",
      "description": "Global state for the application",
      "type": "object",
      "properties": {
        "stateJson": {
          "type": "string"
        }
      },
      "required": [
        "stateJson"
      ]
    },
    "EmailTemplate": {
      "title": "EmailTemplate",
      "description": "Draft email templates for agent outreach",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isArchived": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "subject",
        "body",
        "isArchived",
        "ownerId"
      ]
    },
    "TwilioVault": {
      "title": "TwilioVault",
      "description": "Secure storage for encrypted Twilio credentials",
      "type": "object",
      "properties": {
        "encryptedVault": { "type": "string", "maxLength": 2048 },
        "enableLiveCarrierSms": { "type": "boolean" },
        "ownerId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string" }
      },
      "required": ["encryptedVault", "enableLiveCarrierSms", "ownerId", "updatedAt"]
    },
    "UserIntegrations": {
      "title": "UserIntegrations",
      "description": "User third party integrations configuration and vault",
      "type": "object",
      "properties": {
        "salesforceVault": { "type": "string" },
        "totalExpertVault": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global application settings including public visibility and SEO metadata",
      "type": "object",
      "properties": {
        "isPublic": { "type": "boolean" },
        "seoMetadata": { "type": "object" },
        "metaTitle": { "type": "string" },
        "metaDescription": { "type": "string" },
        "ogTitle": { "type": "string" },
        "ogDescription": { "type": "string" },
        "ogImage": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastUpdatedBy": { "type": "string" }
      }
    },
    "BranchAuditLog": {
      "title": "BranchAuditLog",
      "description": "Immutable security and compliance audit log recording team members access to sensitive CRM assets like API keys, webhooks, and private customer data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorEmail": { "type": "string" },
        "actorName": { "type": "string" },
        "actorRole": { "type": "string" },
        "actionType": { "type": "string" },
        "actionLabel": { "type": "string" },
        "assetCategory": { "type": "string" },
        "assetName": { "type": "string" },
        "targetAssetId": { "type": "string" },
        "status": { "type": "string" },
        "severity": { "type": "string" },
        "ipAddress": { "type": "string" },
        "userAgent": { "type": "string" },
        "details": { "type": "string" },
        "rbacPolicyRule": { "type": "string" },
        "integrityHash": { "type": "string" },
        "previousHash": { "type": "string" },
        "sequenceIndex": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": [
        "id",
        "actorEmail",
        "actionType",
        "assetCategory",
        "assetName",
        "status",
        "timestamp"
      ]
    },
    "WebhookEvent": {
      "title": "WebhookEvent",
      "description": "Persisted inbound and outbound CRM webhook events with zero-lateral RBAC segregation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "event": { "type": "string" },
        "ownerLoId": { "type": "string" },
        "targetLoId": { "type": "string" },
        "candidateName": { "type": "string" },
        "candidateType": { "type": "string" },
        "source": { "type": "string" },
        "status": { "type": "string" },
        "payload": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": [
        "id",
        "timestamp",
        "event",
        "status"
      ]
    }
  },
  "firestore": {
    "webhook_events/{eventId}": {
      "schema": { "$ref": "#/entities/WebhookEvent" },
      "description": "Persisted webhook event stream with zero-lateral originator isolation"
    },
    "branch_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/BranchAuditLog" },
      "description": "Branch security audit records for sensitive CRM assets, webhooks, and customer PII access"
    },
    "app_settings/{docId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Global application configuration and SEO metadata"
    },
    "twilio_vault/{userId}": {
      "schema": { "$ref": "#/entities/TwilioVault" },
      "description": "Encrypted Twilio credentials for a user"
    },
    "user_integrations/{userId}": {
      "schema": { "$ref": "#/entities/UserIntegrations" },
      "description": "User third party integrations"
    },
    "guides_state/{docId}": {
      "schema": "GuidesState",
      "description": "Global state singleton"
    },
    "loan_officers/{loId}": {
      "schema": "LoanOfficerProfile",
      "description": "Loan officers collection"
    },
    "agents/{agentId}": {
      "schema": "RealEstateAgentProfile",
      "description": "Agents collection"
    },
    "email_templates/{templateId}": {
      "schema": "EmailTemplate",
      "description": "Email templates created by loan officers"
    }
  }
}