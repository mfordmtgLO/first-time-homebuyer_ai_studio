{
  "entities": {
    "LoanOfficerProfile": {
      "title": "LoanOfficerProfile",
      "description": "Loan Officer Profile containing headshot and other details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "nmlsId": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "headshotUrl": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        },
        "websiteUrl": {
          "type": "string"
        },
        "customSlug": {
          "type": "string"
        },
        "isAdmin": {
          "type": "boolean"
        },
        "password": {
          "type": "string"
        },
        "passwordResetAuthorized": {
          "type": "boolean"
        },
        "passwordResetRequestedAt": {
          "type": "string"
        },
        "passwordResetAuthorizedAt": {
          "type": "string"
        },
        "passwordResetPin": {
          "type": "string"
        },
        "lastLogin": {
          "type": "string"
        },
        "themePreference": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "RealEstateAgentProfile": {
      "title": "RealEstateAgentProfile",
      "description": "Real Estate Agent Profile containing headshot and other details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "brokerage": {
          "type": "string"
        },
        "licenseNumber": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "headshotUrl": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "GuidesState": {
      "title": "GuidesState",
      "description": "Global state for the application",
      "type": "object",
      "properties": {
        "stateJson": {
          "type": "string"
        }
      },
      "required": [
        "stateJson"
      ]
    },
    "EmailTemplate": {
      "title": "EmailTemplate",
      "description": "Draft email templates for agent outreach",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isArchived": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "subject",
        "body",
        "isArchived",
        "ownerId"
      ]
    },
    "TwilioVault": {
      "title": "TwilioVault",
      "description": "Secure storage for encrypted Twilio credentials",
      "type": "object",
      "properties": {
        "encryptedVault": { "type": "string", "maxLength": 2048 },
        "enableLiveCarrierSms": { "type": "boolean" },
        "ownerId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string" }
      },
      "required": ["encryptedVault", "enableLiveCarrierSms", "ownerId", "updatedAt"]
    },
    "UserIntegrations": {
      "title": "UserIntegrations",
      "description": "User third party integrations configuration and vault",
      "type": "object",
      "properties": {
        "salesforceVault": { "type": "string" },
        "totalExpertVault": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global application settings including public visibility and SEO metadata",
      "type": "object",
      "properties": {
        "isPublic": { "type": "boolean" },
        "seoMetadata": { "type": "object" },
        "metaTitle": { "type": "string" },
        "metaDescription": { "type": "string" },
        "ogTitle": { "type": "string" },
        "ogDescription": { "type": "string" },
        "ogImage": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastUpdatedBy": { "type": "string" }
      }
    },
    "BranchAuditLog": {
      "title": "BranchAuditLog",
      "description": "Immutable security and compliance audit log recording team members access to sensitive CRM assets like API keys, webhooks, and private customer data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorEmail": { "type": "string" },
        "actorName": { "type": "string" },
        "actorRole": { "type": "string" },
        "actionType": { "type": "string" },
        "actionLabel": { "type": "string" },
        "assetCategory": { "type": "string" },
        "assetName": { "type": "string" },
        "targetAssetId": { "type": "string" },
        "status": { "type": "string" },
        "severity": { "type": "string" },
        "ipAddress": { "type": "string" },
        "userAgent": { "type": "string" },
        "details": { "type": "string" },
        "rbacPolicyRule": { "type": "string" },
        "integrityHash": { "type": "string" },
        "previousHash": { "type": "string" },
        "sequenceIndex": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": [
        "id",
        "actorEmail",
        "actionType",
        "assetCategory",
        "assetName",
        "status",
        "timestamp"
      ]
    },
    "WebhookEvent": {
      "title": "WebhookEvent",
      "description": "Persisted inbound and outbound CRM webhook events with zero-lateral RBAC segregation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "event": { "type": "string" },
        "ownerLoId": { "type": "string" },
        "targetLoId": { "type": "string" },
        "candidateName": { "type": "string" },
        "candidateType": { "type": "string" },
        "source": { "type": "string" },
        "status": { "type": "string" },
        "payload": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": [
        "id",
        "timestamp",
        "event",
        "status"
      ]
    },
    "WhitelistedEmail": {
      "title": "WhitelistedEmail",
      "description": "Authorized employee email address with designated RBAC role and provisioning details",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "notes": { "type": "string" },
        "addedBy": { "type": "string" },
        "addedAt": { "type": "string" },
        "assignedLoId": { "type": "string" },
        "customPermissions": { "type": "object" }
      },
      "required": ["email", "role"]
    },
    "DailyPulse": {
      "title": "DailyPulse",
      "description": "3-part daily AI sentiment, task-to-goal tracking, and sales manager coaching memory for loan officers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loId": { "type": "string" },
        "loName": { "type": "string" },
        "date": { "type": "string" },
        "timePhase": { "type": "string" },
        "timeString": { "type": "string" },
        "timestamp": { "type": "string" },
        "totalTasks": { "type": "number" },
        "completedTasks": { "type": "number" },
        "completionPercent": { "type": "number" },
        "completedTitles": { "type": "array" },
        "pendingTitles": { "type": "array" },
        "allTasksSnapshot": { "type": "array" },
        "reviewData": { "type": "object" },
        "yesterdayHandoffSummary": { "type": "string" }
      },
      "required": ["id", "loId", "date", "timePhase", "timestamp", "totalTasks", "completedTasks"]
    },
    "WeeklyPulse": {
      "title": "WeeklyPulse",
      "description": "Week-to-week loan officer performance pacing, task completion variance, and executive sales management directives",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loId": { "type": "string" },
        "loName": { "type": "string" },
        "weekNumber": { "type": "number" },
        "year": { "type": "number" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "totalTasksTargeted": { "type": "number" },
        "totalTasksCompleted": { "type": "number" },
        "completionRate": { "type": "number" },
        "daysActive": { "type": "number" },
        "weekOverWeekTrend": { "type": "string" },
        "priorWeekComparisonSummary": { "type": "string" },
        "executiveWeeklyReview": { "type": "object" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "loId", "weekNumber", "year", "startDate", "endDate", "timestamp"]
    },
    "MonthlyHorizonPulse": {
      "title": "MonthlyHorizonPulse",
      "description": "30-day lookback retrospective and 30-day lookforward production roadmap guidance for loan officers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loId": { "type": "string" },
        "loName": { "type": "string" },
        "month": { "type": "string" },
        "monthLabel": { "type": "string" },
        "timestamp": { "type": "string" },
        "lookback30Days": { "type": "object" },
        "lookforward30Days": { "type": "object" },
        "productivityScore": { "type": "number" },
        "pacingStatus": { "type": "string" }
      },
      "required": ["id", "loId", "month", "timestamp", "lookback30Days", "lookforward30Days"]
    },
    "UserPreference": {
      "title": "UserPreference",
      "description": "User specific interface preferences such as themePreference (light, dark, system)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "themePreference": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["themePreference"]
    }
  },
  "firestore": {
    "daily_pulses/{pulseId}": {
      "schema": { "$ref": "#/entities/DailyPulse" },
      "description": "Cross-session persistent daily AI reviews, task completion metrics, and performance coaching history"
    },
    "weekly_pulses/{pulseId}": {
      "schema": { "$ref": "#/entities/WeeklyPulse" },
      "description": "Week-to-week persistent AI retrospectives, task velocity, and sales manager directives"
    },
    "monthly_pulses/{pulseId}": {
      "schema": { "$ref": "#/entities/MonthlyHorizonPulse" },
      "description": "30-day lookback retrospective and 30-day lookforward production roadmap guidance"
    },
    "whitelisted_emails/{emailId}": {
      "schema": { "$ref": "#/entities/WhitelistedEmail" },
      "description": "Whitelisted team emails and assigned RBAC roles for branch access control"
    },
    "webhook_events/{eventId}": {
      "schema": { "$ref": "#/entities/WebhookEvent" },
      "description": "Persisted webhook event stream with zero-lateral originator isolation"
    },
    "branch_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/BranchAuditLog" },
      "description": "Branch security audit records for sensitive CRM assets, webhooks, and customer PII access"
    },
    "app_settings/{docId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Global application configuration and SEO metadata"
    },
    "twilio_vault/{userId}": {
      "schema": { "$ref": "#/entities/TwilioVault" },
      "description": "Encrypted Twilio credentials for a user"
    },
    "user_integrations/{userId}": {
      "schema": { "$ref": "#/entities/UserIntegrations" },
      "description": "User third party integrations"
    },
    "guides_state/{docId}": {
      "schema": "GuidesState",
      "description": "Global state singleton"
    },
    "loan_officers/{loId}": {
      "schema": "LoanOfficerProfile",
      "description": "Loan officers collection"
    },
    "agents/{agentId}": {
      "schema": "RealEstateAgentProfile",
      "description": "Agents collection"
    },
    "email_templates/{templateId}": {
      "schema": "EmailTemplate",
      "description": "Email templates created by loan officers"
    },
    "user_preferences/{userId}": {
      "schema": { "$ref": "#/entities/UserPreference" },
      "description": "Cross-device user interface preferences including light/dark theme preference"
    }
  }
}