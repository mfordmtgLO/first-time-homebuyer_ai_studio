rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isMasterAdminEmail() {
      return 'email' in request.auth.token && request.auth.token.email != null &&
             request.auth.token.email.lower() in ['fordmj@gmail.com', 'mford@cfmtg.com'];
    }
    function isMasterAdmin() {
      return isSignedIn() &&
             (isMasterAdminEmail() ||
              (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
               (('role' in get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data &&
                 get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin') ||
                ('rbacRole' in get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data &&
                 get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.rbacRole == 'branch_manager'))));
    }
    function isAdmin() {
      return isMasterAdmin();
    }
    function isBranchManager() {
      return isMasterAdmin();
    }
    function getUserRoleDoc() {
      return get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data;
    }
    function isSeniorLo() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
             getUserRoleDoc().rbacRole == 'senior_lo';
    }
    function isTeamLo() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
             getUserRoleDoc().rbacRole == 'team_lo';
    }
    function isProcessor() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
             getUserRoleDoc().rbacRole == 'processor';
    }
    function isLoStaff() {
      return isSeniorLo() || isTeamLo() || isProcessor();
    }
    function callerTokenEmail() {
      return ('email' in request.auth.token && request.auth.token.email != null) ?
             request.auth.token.email.lower() : '';
    }
    function isComplianceAuditor() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
         'rbacRole' in getUserRoleDoc() &&
         getUserRoleDoc().rbacRole == 'compliance_auditor') ||
        (callerTokenEmail() != '' &&
         exists(/databases/$(database)/documents/whitelisted_emails/$(callerTokenEmail())) &&
         'role' in get(/databases/$(database)/documents/whitelisted_emails/$(callerTokenEmail())).data &&
         get(/databases/$(database)/documents/whitelisted_emails/$(callerTokenEmail())).data.role == 'compliance_auditor') ||
        (callerTokenEmail() == 'auditor@yourcompany.com')
      );
    }
    function getCallerAssignedLoId() {
      return (callerTokenEmail() != '' &&
              exists(/databases/$(database)/documents/whitelisted_emails/$(callerTokenEmail())) &&
              'assignedLoId' in get(/databases/$(database)/documents/whitelisted_emails/$(callerTokenEmail())).data &&
              get(/databases/$(database)/documents/whitelisted_emails/$(callerTokenEmail())).data.assignedLoId != null)
             ? get(/databases/$(database)/documents/whitelisted_emails/$(callerTokenEmail())).data.assignedLoId
             : (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
                'assignedLoId' in getUserRoleDoc() &&
                getUserRoleDoc().assignedLoId != null
                ? getUserRoleDoc().assignedLoId
                : null);
    }
    function canAccessOwnedLead() {
      return isLoStaff() &&
             'ownerLoId' in resource.data &&
             resource.data.ownerLoId != null &&
             getCallerAssignedLoId() != null &&
             resource.data.ownerLoId == getCallerAssignedLoId();
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Staff role grants. Self-provisioning on login (authUtils checkAndProvisionUser)
    // is bound to the caller's verified token email AND the whitelisted_emails
    // entry for that email: a signer can never mint admin/branch_manager power
    // unless their own whitelist entry grants branch_manager. Branch managers
    // (email-constant or doc) may manage any role doc.
    function whitelistRoleForSelf() {
      return get(/databases/$(database)/documents/whitelisted_emails/$(request.auth.token.email.lower())).data.role;
    }
    function claimsAdminPower(data) {
      return (('role' in data && data.role == 'admin') ||
              ('rbacRole' in data && (data.rbacRole == 'branch_manager' || data.rbacRole == 'admin')));
    }
    match /user_roles/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isBranchManager());
      allow list: if isBranchManager();
      allow create, update: if isSignedIn() && (
        isBranchManager() ||
        (request.auth.uid == userId &&
         'email' in request.auth.token && request.auth.token.email != null &&
         incoming().email == request.auth.token.email.lower() &&
         exists(/databases/$(database)/documents/whitelisted_emails/$(request.auth.token.email.lower())) &&
         (!claimsAdminPower(incoming()) ||
          whitelistRoleForSelf() in ['branch_manager', 'admin']) &&
         (request.method == 'create' ? 
           (!('loId' in incoming()) && !('customPermissions' in incoming())) : 
           ((!('loId' in incoming()) || incoming().loId == resource.data.loId) && 
            (!('customPermissions' in incoming()) || incoming().customPermissions == resource.data.customPermissions)))
        )
      );
      allow delete: if isBranchManager();
    }
    
    match /app_settings/{docId} {
      // Unauthenticated public site reads global config + SEO metadata (App.tsx,
      // seoManager fetchSavedSeoMetadata), so read stays public.
      allow read: if true;
      // Writes come only from the staff portal: BranchManagement (public/private
      // toggle) and MetadataConfiguration (SEO metadata editor).
      allow write: if isSignedIn() && isBranchManager();
    }

    match /user_preferences/{userId} {
      // Cross-device theme preference (ThemeProvider): always keyed by the
      // signed-in user's own Firebase Auth uid, read and written only on login.
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /whitelisted_emails/{emailId} {
      // Login flow (authUtils checkAndProvisionUser) reads the caller's own entry
      // after Firebase sign-in; doc ids are lowercased emails. The staff directory
      // listing stays branch-manager only.
      allow get: if isSignedIn() && 'email' in request.auth.token && request.auth.token.email != null &&
                 (isBranchManager() || emailId == request.auth.token.email.lower());
      allow list: if isSignedIn() && isBranchManager();
      // Staff invite / role management UI (BranchManagement) is branch-manager only.
      allow create, update, delete: if isSignedIn() && isBranchManager();
    }

    match /webhook_events/{eventId} {
      // Zero-lateral access control: Branch Managers see all; originators only see assigned webhooks
      allow get: if isSignedIn() && isValidId(eventId) && (
        isBranchManager() || 
        (resource != null && (resource.data.ownerLoId == request.auth.uid || resource.data.targetLoId == request.auth.uid))
      );
      allow list: if isSignedIn() && (
        isBranchManager() ||
        resource.data.ownerLoId == request.auth.uid ||
        resource.data.targetLoId == request.auth.uid
      );
      allow create, update, delete: if isBranchManager();
    }

    match /branch_audit_logs/{logId} {
      // Branch Managers can read all logs. Originators can read their own logs.
      allow get: if isSignedIn() && isValidId(logId) && (
        isBranchManager() || 
        (resource != null && resource.data.actorEmail == request.auth.token.email)
      );
      allow list: if isSignedIn() && isBranchManager();
      // Signed in team members can append audit events
      allow create: if isSignedIn() && isValidId(logId) && (
        isBranchManager() ||
        (incoming().actorEmail == request.auth.token.email)
      );
      // Immutability: audit logs cannot be altered or erased
      allow update, delete: if false;
    }

    function isValidTwilioVault(data) {
      return data.keys().hasAll(['encryptedVault', 'enableLiveCarrierSms', 'ownerId', 'updatedAt']) &&
             data.keys().size() == 4 &&
             data.encryptedVault is string && data.encryptedVault.size() <= 2048 &&
             data.enableLiveCarrierSms is bool &&
             data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid;
    }

    match /twilio_vault/{userId} {
      allow get, delete: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isBranchManager());
      allow create, update: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isBranchManager());
    }

    function isValidIntegrationsVault(data) {
      return data.keys().hasAll(['encryptedVault', 'ownerId', 'updatedAt']) &&
             data.encryptedVault is string && data.encryptedVault.size() <= 8192 &&
             data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid;
    }

    match /integrations_vault/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isBranchManager());
      allow delete: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isBranchManager());
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid &&
                    (isBranchManager() || isSeniorLo()) &&
                    isValidIntegrationsVault(incoming()) && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid &&
                    (isBranchManager() || isSeniorLo()) &&
                    isValidIntegrationsVault(incoming()) && incoming().updatedAt == request.time &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['encryptedVault', 'updatedAt']);
    }

    match /user_integrations/{userId} {
      allow get, delete, create, update: if isSignedIn() && isValidId(userId) && (userId == request.auth.uid || isBranchManager());
    }

    match /daily_pulses/{pulseId} {
      // Loan officers can read/write their own daily pulses; branch managers can view team pulses
      allow get: if isSignedIn() && isValidId(pulseId) && (
        isBranchManager() ||
        (resource != null && resource.data.loId == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        isBranchManager() ||
        resource.data.loId == request.auth.uid
      );
      allow create, update: if isSignedIn() && isValidId(pulseId) && (
        isBranchManager() ||
        (incoming().loId == request.auth.uid)
      );
      allow delete: if isBranchManager();
    }

    match /weekly_pulses/{pulseId} {
      allow get: if isSignedIn() && isValidId(pulseId) && (
        isBranchManager() ||
        (resource != null && resource.data.loId == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        isBranchManager() ||
        resource.data.loId == request.auth.uid
      );
      allow create, update: if isSignedIn() && isValidId(pulseId) && (
        isBranchManager() ||
        (incoming().loId == request.auth.uid)
      );
      allow delete: if isBranchManager();
    }

    match /monthly_pulses/{pulseId} {
      allow get: if isSignedIn() && isValidId(pulseId) && (
        isBranchManager() ||
        (resource != null && resource.data.loId == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        isBranchManager() ||
        resource.data.loId == request.auth.uid
      );
      allow create, update: if isSignedIn() && isValidId(pulseId) && (
        isBranchManager() ||
        (incoming().loId == request.auth.uid)
      );
      allow delete: if isBranchManager();
    }

    // Public co-branded guide profiles, published properties, and roadmap configuration
    match /guides_state/{docId} { 
      allow read: if true; 
      allow write: if isSignedIn(); 
    }
    // Sharded lead documents to prevent 1MB single-document cap
    match /leads/{leadId} {
      // Scoped reads: branch_manager and compliance_auditor can read all leads.
      // LO staff (senior_lo, team_lo, processor) can read ONLY leads where ownerLoId == caller's assignedLoId.
      // A lead with no ownerLoId is readable ONLY by branch_manager and auditor.
      allow read: if isSignedIn() && (
        isBranchManager() ||
        isComplianceAuditor() ||
        canAccessOwnedLead()
      );
      // Anyone can create their lead profile
      allow create: if true;
      // Updates: branch_manager can update all leads. LO staff can update only their owned leads.
      // Auditor has zero update rights. Lead owner buyer can update their own record.
      allow update: if (isSignedIn() && (
        isBranchManager() ||
        canAccessOwnedLead()
      )) || (request.auth.uid == leadId);
      // Delete: restricted to branch_manager
      allow delete: if isSignedIn() && isBranchManager();
    }

    match /lead_curations/{leadId} {
      // Branch Managers/Admins can read/list all; buyers can read only their own.
      allow get: if isSignedIn() && (isBranchManager() || request.auth.uid == leadId);
      allow list: if isSignedIn() && isBranchManager();
      // Only Branch Managers can marry/unmarry listings (write/create/delete).
      allow create, update, delete: if isSignedIn() && isBranchManager();
    }

    match /loan_officers/{loId} { 
      allow read: if true; 
      allow write: if isSignedIn(); 
    }
    match /agents/{agentId} { 
      allow read: if true; 
      allow write: if isSignedIn(); 
    }
    match /pairings/{pairingId} { 
      allow read: if true; 
      allow write: if isSignedIn(); 
    }
    match /email_templates/{templateId} { 
      allow read: if true; 
      allow write: if isSignedIn(); 
    }

    // Canonical curated listings collection (P1-1). Server-side updates only (firebase-admin).
    match /curated_listings/{listingId} {
      // Direct client writes are denied; all writes happen server-side during GeoSphere sync.
      allow read: if true;
      allow write: if false;
    }

    // Bidirectional property conversation notes between website visitors and loan officers.
    // Visitors are ANONYMOUS (visitor lead id lives in localStorage; no Firebase Auth),
    // so thread writes cannot be auth-gated without breaking the feature. Reads are
    // split instead: anyone may fetch a single known thread, but enumerating the whole
    // collection (buyer names, emails, phones in every thread) requires signed-in staff.
    // Residual risk: anonymous writers can create threads and append to any thread whose
    // id they know/guess, and can spam the LO action-item panel. Mitigate server-side
    // (Cloud Function validation, App Check) if abuse appears; do not store sensitive
    // PII beyond what the feature needs.
    match /property_conversations/{conversationId} {
      allow get: if true;
      allow list: if isSignedIn() && (isBranchManager() || isSeniorLo() || isTeamLo() || isProcessor());
      allow create: if isValidId(conversationId) &&
                       incoming().leadId is string && incoming().propertyId is string &&
                       incoming().messages is list && incoming().messages.size() <= 25;
      allow update: if isValidId(conversationId) &&
                       incoming().messages is list && incoming().messages.size() <= 500;
      allow delete: if isSignedIn() && isBranchManager();
    }

    match /price_drop_alerts/{alertId} {
      allow read: if true;
      allow write: if isSignedIn() || isValidId(alertId);
    }
  }
}
