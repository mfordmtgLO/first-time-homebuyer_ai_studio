rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin';
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    match /user_roles/{userId} {
      allow get, create, update: if isSignedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }
    
    match /whitelisted_emails/{emailId} {
      allow get: if isSignedIn(); // Allow users to check if their email is whitelisted
      allow read, write: if isAdmin();
    }

    function isValidTwilioVault(data) {
      return data.keys().hasAll(['encryptedVault', 'enableLiveCarrierSms', 'ownerId', 'updatedAt']) &&
             data.keys().size() == 4 &&
             data.encryptedVault is string && data.encryptedVault.size() <= 2048 &&
             data.enableLiveCarrierSms is bool &&
             data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid;
    }

    match /twilio_vault/{userId} {
      allow get, delete: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid &&
                    isValidTwilioVault(incoming()) && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid &&
                    isValidTwilioVault(incoming()) && incoming().updatedAt == request.time &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['encryptedVault', 'enableLiveCarrierSms', 'updatedAt']);
    }

    function isValidIntegrationsVault(data) {
      return data.keys().hasAll(['encryptedVault', 'ownerId', 'updatedAt']) &&
             data.encryptedVault is string && data.encryptedVault.size() <= 8192 &&
             data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid;
    }

    match /integrations_vault/{userId} {
      allow get, delete: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid &&
                    isValidIntegrationsVault(incoming()) && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid &&
                    isValidIntegrationsVault(incoming()) && incoming().updatedAt == request.time &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['encryptedVault', 'updatedAt']);
    }

    // Existing open rules for prototyping. 
    // In the future, we will lock these down to `isOwner(userId)`
    match /guides_state/{docId} { allow read, write: if isSignedIn(); }
    match /loan_officers/{loId} { allow read, write: if isSignedIn(); }
    match /agents/{agentId} { allow read, write: if isSignedIn(); }
    match /pairings/{pairingId} { allow read, write: if isSignedIn(); }
    match /email_templates/{templateId} { allow read, write: if isSignedIn(); }
  }
}
