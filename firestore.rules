rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    // We allow open read and write for the prototype CMS.
    // In production, we would use Firebase Auth to restrict access.
    match /guides_state/{docId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /loan_officers/{loId} {
      allow read: if true;
      allow write: if true; 
    }
    
    match /agents/{agentId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /pairings/{pairingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
